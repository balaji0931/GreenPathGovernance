# GreenPath Environment Configuration
# Copy this file to .env and customize for your deployment

SECRET_KEY=django-insecure-greenpath-session-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Neon Cloud PostgreSQL Connection String
# Example: postgresql://user:password@ep-greenpath.neon.tech/neondb?sslmode=require
# If left blank, GreenPath seamlessly uses local SQLite
DATABASE_URL=

